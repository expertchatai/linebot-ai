# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
# Service role key (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# ─── LINE OA: Customer channel ──────────────────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ─── LINE OA: Admin channel (separate OA for staff commands + group notifications)
LINE_ADMIN_CHANNEL_SECRET=
LINE_ADMIN_CHANNEL_ACCESS_TOKEN=
# Group IDs — invite the admin OA into each group, then type GROUPID in the group
LINE_ADMIN_GROUP_ID=
LINE_SUPER_ADMIN_GROUP_ID=
# Comma-separated LINE user IDs that are always Super Admin (type MYID to the admin OA)
SUPER_ADMIN_LINE_USER_IDS=

# ─── Facebook Messenger ─────────────────────────────────────
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=
FB_GRAPH_VERSION=v21.0

# ─── Google Gemini ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ─── Google Sheets (read-only) ──────────────────────────────
GOOGLE_SHEETS_ID=1GXglURewLCrX9Gpv9GtXKgSWdgn1l29Hnb80P_dK1lw
# Preferred: service account JSON (one line). Share the sheet with its email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Fallback for a sheet shared "anyone with the link": an API key with Sheets API enabled
GOOGLE_API_KEY=

# ─── Security ───────────────────────────────────────────────
# Bearer token for /api/jobs/tick (scheduler)
CRON_SECRET=
DASHBOARD_PASSWORD=
# Random 32+ chars, used to sign dashboard sessions
SESSION_SECRET=

# Hard gate: Live Mode cannot be enabled unless this is "true"
# AND a Super Admin confirms the MODE LIVE command.
ALLOW_LIVE_MODE=false
